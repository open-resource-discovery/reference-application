{
  "name": "@open-resource-discovery/reference-application",
  "version": "1.1.1",
  "description": "This is a reference application for the Open Resource Discovery protocol",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=26.0.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "build": "rimraf dist && tsc",
    "start": "node ./dist/src/server.js",
    "dev": "tsx watch ./src/server.ts",
    "lint": "biome lint --write .",
    "lint:ci": "biome lint .",
    "format": "biome format --write .",
    "format:ci": "biome format .",
    "check": "biome check .",
    "test": "npm run build && node --test dist/src/__tests__/*.test.js",
    "test:ci": "npm run build && node --test --experimental-test-coverage dist/src/__tests__/*.test.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/open-resource-discovery/reference-application"
  },
  "author": "SAP SE",
  "dependencies": {
    "@fastify/basic-auth": "6.3.0",
    "@fastify/etag": "6.2.0",
    "@fastify/static": "10.1.3",
    "fastify": "^5.12.3",
    "lodash": "^4.18.1",
    "pino-pretty": "^13.1.3",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@open-resource-discovery/specification": "^1.16.3",
    "@tsconfig/node26": "^26.0.1",
    "@types/json-schema": "^7.0.15",
    "@types/lodash": "^4.17.25",
    "@types/node": "^26.5.1",
    "openapi-types": "^12.1.3",
    "rimraf": "^6.1.3",
    "tsx": "4.23.13",
    "typescript": "^7.0.2"
  }
}
