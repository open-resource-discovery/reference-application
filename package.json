{
  "name": "@open-resource-discovery/reference-application",
  "version": "1.1.1",
  "description": "This is a reference application for the Open Resource Discovery protocol",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24.22.1",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "prebuild": "node scripts/clean.mjs",
    "build": "npm run build:ui && tsc",
    "build:ui": "tsc --project ui/tsconfig.json && vite build",
    "start": "node ./dist/src/server.js",
    "predev": "npm run build:ui",
    "dev": "node --watch ./src/server.ts",
    "lint": "biome lint --write .",
    "lint:ci": "biome lint .",
    "format": "biome format --write .",
    "format:ci": "biome format .",
    "check": "biome check .",
    "test": "node --test src/__tests__/*.test.ts",
    "test:ci": "node --test --experimental-test-coverage src/__tests__/*.test.ts"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/open-resource-discovery/reference-application"
  },
  "author": "SAP SE",
  "overrides": {
    "dompurify": "^3.4.17",
    "@open-resource-discovery/explorer": {
      "hono": "^4.13.16",
      "undici": "^8.12.3"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@open-resource-discovery/explorer": "^0.2.1",
    "@open-resource-discovery/specification": "^1.17.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "buffer": "^6.0.3",
    "openapi-types": "^12.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
