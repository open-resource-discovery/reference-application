{
  "name": "@open-resource-discovery/reference-application",
  "version": "1.1.1",
  "description": "This is a reference application for the Open Resource Discovery protocol",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "build": "rimraf dist && tsc",
    "start": "node ./dist/src/server.js",
    "dev": "tsx watch ./src/server.ts",
    "lint": "eslint . --fix",
    "lint:ci": "eslint .",
    "prettier": "prettier --write \"**/*.{json,yml,yaml,md}\"",
    "prettier:ci": "prettier --check \"**/*.{json,yml,yaml,md}\"",
    "format": "npm run prettier && npm run lint",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watchAll",
    "test:ci": "node --experimental-vm-modules node_modules/jest/bin/jest.js --ci --collectCoverage"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/open-resource-discovery/reference-application"
  },
  "author": "SAP SE",
  "dependencies": {
    "@fastify/basic-auth": "6.3.0",
    "@fastify/etag": "6.2.0",
    "@fastify/static": "10.1.3",
    "fastify": "^5.12.3",
    "lodash": "^4.18.1",
    "pino-pretty": "^13.1.3",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@open-resource-discovery/specification": "^1.16.3",
    "@sap/eslint-config": "^0.5.2",
    "@tsconfig/node20": "20.1.10",
    "@types/jest": "^30.0.0",
    "@types/json-schema": "^7.0.15",
    "@types/lodash": "^4.17.25",
    "@types/node": "^24.13.4",
    "eslint": "^10.10.0",
    "jest": "^30.5.1",
    "jest-util": "30.5.1",
    "openapi-types": "^12.1.3",
    "prettier": "3.9.6",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.4.12",
    "tsx": "4.23.13",
    "typescript": "~5.9.3"
  }
}
