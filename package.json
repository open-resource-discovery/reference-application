{
  "name": "@open-resource-discovery/reference-application",
  "version": "1.1.1",
  "description": "This is a reference application for the Open Resource Discovery protocol",
  "type": "module",
  "private": true,
  "engines": {
    "node": "24.x",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "prebuild": "node scripts/clean.mjs",
    "build": "tsc",
    "start": "node ./dist/src/server.js",
    "dev": "node --watch ./src/server.ts",
    "lint": "biome lint --write .",
    "lint:ci": "biome lint .",
    "format": "biome format --write .",
    "format:ci": "biome format .",
    "check": "biome check .",
    "test": "node --test src/__tests__/*.test.ts",
    "test:ci": "node --test --experimental-test-coverage src/__tests__/*.test.ts"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/open-resource-discovery/reference-application"
  },
  "author": "SAP SE",
  "dependencies": {
    "@fastify/basic-auth": "6.3.0",
    "@fastify/etag": "6.2.0",
    "@fastify/static": "10.1.3",
    "fastify": "^5.12.3",
    "pino-pretty": "^13.1.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@open-resource-discovery/specification": "^1.16.3",
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^24.13.4",
    "openapi-types": "^12.1.3",
    "typescript": "^7.0.2"
  }
}
