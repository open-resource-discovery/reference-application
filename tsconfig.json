{
  "extends": "@tsconfig/node24/tsconfig.json",
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": ".",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "rewriteRelativeImportExtensions": true,
    "paths": {
      "src/*": ["./src/*"]
    },
    "types": ["node"],
    "isolatedModules": true
  },
  "include": ["./src/**/*"],
  "exclude": ["node_modules", "dist", "deps"]
}
